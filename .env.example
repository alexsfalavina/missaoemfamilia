# ============================================================
# JESSICA AI MARKETING — Variáveis de Ambiente
# ATENÇÃO:
# - Apenas NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   podem usar o prefixo NEXT_PUBLIC_ (conforme documentação atual do Supabase).
# - SUPABASE_SECRET_KEY e todas as demais credenciais são EXCLUSIVAS do servidor.
# ============================================================

# 1. Supabase (Free Tier — projeto de desenvolvimento)
# Variáveis públicas (compatíveis com cliente e servidor sob RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variáveis exclusivas do servidor (NUNCA usar NEXT_PUBLIC_ na chave secreta)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=jessica-media
# Trava obrigatória: mantém seed demonstrativo DESATIVADO no Supabase (sempre bloqueado em produção)
ALLOW_DEMO_SEED=false

# 2. Autenticação & Sessão (obrigatório em produção e quando Supabase estiver ativo)
# Gere um segredo aleatório forte (mínimo 32 caracteres) para assinar cookies HttpOnly
AUTH_SESSION_SECRET=
# Credenciais de acesso local/desenvolvimento (usadas SOMENTE sem Supabase configurado)
AUTH_ADMIN_EMAIL=jessica@missaoemfamilia.com
AUTH_ADMIN_PASSWORD=

# 3. Google Gemini API (Etapa P2 — somente servidor, sem custo sem autorização)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. Metricool (Publicação e Métricas futuras do @eujessynalin — desativado na P1/P1.5)
INSTAGRAM_USERNAME=eujessynalin
INSTAGRAM_PROFILE_URL=https://www.instagram.com/eujessynalin/
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Trava obrigatória de segurança: mantém publicação automática desativada na P1/P1.5
ENABLE_METRICOOL_PUBLISHING=false
