# ============================================================
# JESSICA AI MARKETING — Variáveis de Ambiente (Somente Servidor)
# Nunca use prefixo NEXT_PUBLIC_ para chaves de API ou segredos.
# ============================================================

# Supabase (opcional na Etapa 1 — usa persistência local de demonstração se ausente)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (somente servidor — desativado até autorização explícita)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta / Instagram Graph API (somente servidor — publicação bloqueada na Etapa 1)
INSTAGRAM_USERNAME=eujessynalin
INSTAGRAM_PROFILE_URL=https://www.instagram.com/eujessynalin/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Trava de segurança: mantém publicação automática desativada
ENABLE_INSTAGRAM_PUBLISHING=false
